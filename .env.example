# MarkdownMate Environment Variables
# Local-first architecture - minimal configuration needed

# Server Configuration
PORT=5004
NODE_ENV=development

# Note: MarkdownMate v2.0+ stores all data client-side in IndexedDB
# No database, authentication, or external services required

# Winston log file (default: /home/zk/logs/markdownmate.log, where PiDeck reads it)
# LOG_FILE=/home/zk/logs/markdownmate.log
