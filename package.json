{
  "name": "markdownmate",
  "version": "3.5.1",
  "releaseDate": "2026-11-23",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "node scripts/clean-dist.js && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:live": "MARKDOWNMATE_BASE_URL=https://markdownmate.org playwright test --grep @live"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/express": "4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "file-saver": "^2.0.5",
    "globals": "^17.14.0",
    "idb": "^8.0.4",
    "jsdom": "^31.0.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.75.0",
    "monaco-editor": "^0.57.0",
    "postcss": "^8.5.33",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wouter": "^3.13.0",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "katex": "$katex",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.6"
    },
    "monaco-editor": {
      "dompurify": "3.4.18"
    }
  }
}
